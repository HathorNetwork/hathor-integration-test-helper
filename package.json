{
  "name": "hathor-integration-test-helper",
  "version": "0.0.2",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --hot run index.ts",
    "test": "bun run test:unit",
    "test:unit": "bun test __tests__/src",
    "typecheck": "bunx tsc --noEmit",
    "validate:openapi": "bunx --bun validate-api docs/openapi.yaml",
    "check": "bun run typecheck && bun run test:unit"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.9.0",
    "@types/bun": "1.3.9"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@hathor/ct-crypto-node": "0.5.0",
    "@hathor/wallet-lib": "4.3.0"
  }
}
